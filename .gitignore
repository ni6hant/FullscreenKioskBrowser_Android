# Simple Android Kiosk Browser - local Git ignore
# Keeps secrets, caches, build outputs and local config out of version control.

# Generated APKs and build outputs
app/build/
build/
*.apk
*.aab

# Gradle wrapper cache and daemon
.gradle/
**/build/

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# Local SDK / property files (machine-specific; do not commit)
local.properties
keystore.properties
*.keystore
*.jks
*.key

# OS
.DS_Store
Thumbs.db

# Temporary test/scratch files created during development
.opencode_tmp_*.ps1

# ADB device-verification artifacts (not part of the project)
w*.xml
window*.xml
kiosk_*.png
